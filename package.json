{
  "name": "api-erp-njaa",
  "version": "1.0.0",
  "description": "API for the ONG NJAA Management System",
  "main": "server.js",
  "keywords": [
    "ong",
    "management",
    "API",
    "erp",
    "njaa"
  ],
  "author": "SBR Digital <contato@sbrdigital.com.br>",
  "homepage": "https://njaa.ong.br",
  "repository": {
    "type": "git",
    "url": "https://github.com/sbr-digital/apierp-njaa"
  },
  "license": "UNLICENSED",
  "private": "true",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "docker-clean": "docker image prune -f && docker volume prune -f && docker network prune -f",
    "start": "NODE_ENV=production node build/server.js",
    "local": "pnpm run lint && docker-compose up -d &&  npx prisma migrate deploy && npx tsx watch --clear-screen=false src/server.ts",
    "docker:postgres": "docker-compose up -d",
    "build": "rm -rf build && npx tsup src !src/logs/** !src/**/*.spec.ts !src/**/test/**/* --out-dir build --minify",
    "create-module": "tsx scripts/createModule.ts",
    "generate-viewdocs": "tsx scripts/generateProjectTreeView.ts",
    "generate-apidocs": "tsx scripts/generateApiDocs.ts",
    "verify-imports": "tsx verify-imports.eslint.ts",
    "pretest:e2e": "run-s test:create-prisma-environment test:create-install-environment",
    "test:create-prisma-environment": "pnpm link ./prisma/vitest-environment-prisma",
    "test:create-install-environment": "tsx check-symlink.ts",
    "test": "vitest --pool=forks run --dir src/",
    "test:watch": "vitest --dir src/",
    "test:only": "tsx scripts/test-only.ts",
    "test:e2e": "pnpm run pretest:e2e && vitest run --dir e2e/",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts --fix",
    "ci": "pnpm install --frozen-lockfile"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.654.0",
    "@aws-sdk/client-sqs": "^3.654.0",
    "@faker-js/faker": "^10.0.0",
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@prisma/client": "5.19.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "geoip-lite": "1.4.10",
    "jsdom": "25.0.0",
    "lodash": "4.17.21",
    "node-cache": "5.1.2",
    "pino": "9.4.0",
    "pino-pretty": "11.2.2",
    "reflect-metadata": "^0.2.2",
    "sinon": "18.0.0",
    "tsup": "^8.5.0",
    "tsyringe": "4.8.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@rocketseat/eslint-config": "^2.2.2",
    "@types/aws-lambda": "^8.10.145",
    "@types/bcryptjs": "^2.4.6",
    "@types/d3": "7.4.3",
    "@types/geoip-lite": "1.4.4",
    "@types/jsdom": "21.1.7",
    "@types/lodash": "4.17.7",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.15.18",
    "@types/sinon": "17.0.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/experimental-utils": "5.62.0",
    "@vitest/coverage-v8": "^2.1.9",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "d3": "7.9.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "2.29.1",
    "glob": "11.0.0",
    "lefthook": "1.7.15",
    "lint-staged": "^15.5.2",
    "npm-run-all": "4.1.5",
    "prisma": "5.19.1",
    "prisma-dbml-generator": "^0.12.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "5.0.1",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seeds/seeds.ts"
  },
  "pnpm": {
    "overrides": {
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.5",
      "esbuild@<=0.24.2": ">=0.25.5",
      "fast-jwt@<6.0.1": ">=6.0.1",
      "braces@<3.0.3": ">=3.0.3",
      "glob@<8.1.0": ">=8.1.0",
      "semver@<7.5.2": ">=7.5.2"
    },
    "peerDependencyRules": {
      "ignoreMissing": ["@babel/core"]
    }
  }
}